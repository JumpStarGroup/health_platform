# Development Environment Configuration
# Generated by Zhuang

# Kubernetes Configuration
NAMESPACE=health-platform-dev
# Note: Namespace is pre-created; namespace-scoped KUBE_CONFIG is stored in GitHub Secrets

# Container Images
IMAGE_TAG=latest
REGISTRY_URL=ghcr.io/devnextx

# Flask Configuration
FLASK_ENV=development
# DATABASE_URL is intentionally unset; backend uses ephemeral SQLite in /app/instance
# Note: CORS_ORIGINS auto-generated from NAMESPACE if not set in GitHub Environment Variables

# Service Configuration
SERVICE_TYPE=LoadBalancer

# Resource Configuration
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1

# Backend Resource Limits
BACKEND_MEMORY_REQUEST=256Mi
BACKEND_CPU_REQUEST=250m
BACKEND_MEMORY_LIMIT=512Mi
BACKEND_CPU_LIMIT=500m

# Frontend Resource Limits
FRONTEND_MEMORY_REQUEST=128Mi
FRONTEND_CPU_REQUEST=100m
FRONTEND_MEMORY_LIMIT=256Mi
FRONTEND_CPU_LIMIT=200m
